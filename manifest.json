{
  "manifest_version": 3,
  "name": "당근톡",
  "version": "1.0.2",
  "description": "당근 모임 채팅을 회사에서 몰래 하려고 만든 도우미예요. 작은 팝업 창과 엑셀·클로드·지피티 스킨으로 티 안 나게 채팅해요. 당근마켓 공식 확장은 아니에요.",
  "minimum_chrome_version": "105",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "당근톡",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.daangn.com/*"],
      "js": [
        "content/selectors.js",
        "content/theme.js",
        "content/appearance.js",
        "content/popup-layout.js",
        "content/settings-panel.js",
        "content/popup-controls.js",
        "content/double-click-toggle.js",
        "content/scroll-keeper.js",
        "content/paste-image.js"
      ],
      "css": ["themes/kakao.css"],
      "run_at": "document_idle"
    }
  ]
}
